# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.worker — BullMQ Worker (matching / notification)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY src/ ./src/
RUN npm run build

# ── Stage 2: Production ─────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app

RUN addgroup -g 1001 -S logistics && \
    adduser  -S logistics -u 1001

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY --from=builder /app/dist ./dist

ENV NODE_ENV=production
ENV SERVICE_NAME=worker
USER logistics

# No EXPOSE — workers don't serve HTTP
CMD ["node", "--import", "./dist/shared/tracing.js", "dist/workers/entry.js"]
