  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "native:doctor": "npx cap doctor",
    "native:sync": "npx cap sync android",
    "native:prepare": "npm run build && npm run native:sync",
    "native:apk:debug": "npm run native:prepare && node -e \"const { spawnSync } = require('node:child_process'); const isWin = process.platform === 'win32'; const command = isWin ? 'gradlew.bat' : './gradlew'; const result = spawnSync(command, ['assembleDebug'], { cwd: 'android', stdio: 'inherit', shell: isWin }); process.exit(result.status ?? 1);\"",
