# ─── Docker Compose Defaults ─────────────────────────────────────────────────
# Copy this file to .env and fill in runtime values.
# NEVER commit .env to version control.
#
# Docker Compose also expects local secret files under ./secrets/:
# - db_password.txt
# - jwt_public.pem
# - jwt_private.pem
# - stripe_secret_key.txt
# - stripe_webhook_secret.txt
#
# Create those files locally from your secret manager before `docker compose up`.

DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Notification service
SES_FROM_EMAIL=noreply@example.com
SES_REGION=us-east-1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_PROJECT_ID=

# AWS / S3 (Proof of Delivery uploads)
AWS_REGION=us-east-1
S3_POD_BUCKET=rabbittech-logistics-pod
